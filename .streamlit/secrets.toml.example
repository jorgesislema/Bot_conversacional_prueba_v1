# Plantilla de secretos para Streamlit Cloud (docs/06_DESPLIEGUE_STREAMLIT.md).
# Copiar como .streamlit/secrets.toml en local o pegar en el panel de Streamlit.
# Nunca subir valores reales a Git. Si falta la clave principal,
# la app arranca en modo sin IA (solo plantillas) y lo indica en el panel.
PROVEEDOR_PRINCIPAL = ""
CLAVE_PRINCIPAL = ""
# Modelo para el principal. Ejemplo con proveedor europeo: "mistral-small-latest".
MODELO_PRINCIPAL = ""
# URL base opcional. Si se deja vacía se usa la del proveedor nombrado.
URL_PRINCIPAL = ""
PROVEEDOR_RESPALDO = ""
CLAVE_RESPALDO = ""
MODELO_RESPALDO = ""
URL_RESPALDO = ""
LIMITE_DIARIO = 1500
LIMITE_SESION = 40
CLAVE_ADMIN = ""
# Titular que aparece en el pie (los define el dueño del proyecto).
TITULAR = ""
TITULAR_CORREO = ""
